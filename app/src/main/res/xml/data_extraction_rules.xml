        <exclude domain="file" path="linux-sandbox/libtalloc.so.2"/>
        <exclude domain="file" path="linux-sandbox/tmp"/>
        <exclude domain="file" path="linux-sandbox/home/.morsvitaest/llm/models"/>
        <exclude domain="file" path="linux-sandbox/home/.morsvitaest/llm/bin"/>
        <exclude domain="file" path="linux-sandbox/home/.morsvitaest/llm/build"/>
        <exclude domain="file" path="linux-sandbox/home/.morsvitaest/llm/run"/>
        <exclude domain="file" path="linux-sandbox/home/.morsvitaest/llm/logs"/>
        <exclude domain="file" path="open_mine_index.json"/>
    </device-transfer>
</data-extraction-rules>
